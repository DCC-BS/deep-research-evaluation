# Copy to .env and fill in. .env is git-ignored.

# --- Required ---------------------------------------------------------------

# Web search for every candidate (same engine as Bebbi Bot production).
# https://serper.dev -> API key
SERPER_API_KEY=

# Benchmark judges (official DeepResearch Bench judges: GPT-5.5 for RACE,
# GPT-5.4-mini for FACT) via OpenRouter. Only public benchmark data and our
# generated reports are sent.
OPENROUTER_API_KEY=

# NGC API key to pull nvcr.io/nvidia/blueprint/aiq-agent (NVIDIA Deep Researcher).
# https://ngc.nvidia.com -> Setup -> API Key
NGC_API_KEY=

# --- Optional ---------------------------------------------------------------

# Only needed if a model has to be downloaded again (Gemma 4 is gated on HF).
# The cached RedHatAI/gemma-4-31B-it-NVFP4 is used otherwise.
HF_TOKEN=

# --- Local-only values (any random string; no external account needed) -----

# Key the clients use for the local token-metering gateway. Clients send
# "<METER_API_KEY>:<run-tag>" so every token is attributed to a run.
METER_API_KEY=change-me-local-meter-key

# Self-hosted Firecrawl runs without DB auth; this value only has to match
# between the Firecrawl API and its clients.
FIRECRAWL_API_KEY=fc-local-dev

# Postgres password for the Firecrawl queue (nuq-postgres).
FIRECRAWL_POSTGRES_PASSWORD=change-me-local
